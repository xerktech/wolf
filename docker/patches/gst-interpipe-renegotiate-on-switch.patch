diff --git a/gst/interpipe/gstinterpipesink.c b/gst/interpipe/gstinterpipesink.c
index 4e0acfc..b4773d7 100644
--- a/gst/interpipe/gstinterpipesink.c
+++ b/gst/interpipe/gstinterpipesink.c
@@ -979,9 +979,29 @@ gst_inter_pipe_sink_add_listener (GstInterPipeINode * iface,
 
   if (src_negotiated) {
     gboolean has_listeners;
+    GstCaps *padcaps;
+
+    /* The listener negotiated with another node and is switching to this one
+     * (listen-to changed). Nothing below hands it this node's caps unless
+     * they changed or another listener is attached, so it would keep pushing
+     * our buffers under the old node's caps (e.g. system memory buffers under
+     * CUDAMemory caps). Give it the caps this node is streaming now so
+     * downstream renegotiates; appsrc ignores caps equal to its current ones. */
+    padcaps = gst_pad_get_current_caps (GST_INTER_PIPE_SINK_PAD (sink));
+    if (padcaps) {
+      GST_INFO_OBJECT (sink, "Setting listener caps to %" GST_PTR_FORMAT,
+          padcaps);
+      if (!gst_inter_pipe_ilistener_set_caps (listener, padcaps))
+        GST_WARNING_OBJECT (sink, "Failed to set caps to listener %s",
+            listener_name);
+      gst_caps_unref (padcaps);
+    }
 
-    if (!sinkcaps)
+    if (!sinkcaps) {
+      if (srccaps)
+        gst_caps_unref (srccaps);
       goto add_to_list;
+    }
 
     has_listeners = 0 != g_hash_table_size (listeners);
 
