+/* Must be called with listeners_mutex held. Returns the listeners as a
+ * plain list so callbacks may add or remove listener table entries (e.g.
+ * leave_node) without invalidating the iteration. The listener objects
+ * stay valid while listeners_mutex is held: a listener leaves the table
+ * (on stop) under the same lock before it can be finalized. */
+static GList *
+gst_inter_pipe_snapshot_listeners (void)
+{
+  GList *privs, *l, *snapshot = NULL;
+
+  privs = g_hash_table_get_values (gst_inter_pipe_get_listeners ());
+  for (l = privs; l != NULL; l = l->next) {
+    GstInterPipeListenerPriv *listener_priv = l->data;
+    snapshot = g_list_prepend (snapshot, listener_priv->listener);
+  }
+  g_list_free (privs);
+
+  return snapshot;
+}
