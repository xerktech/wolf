+/**
+ * gst_inter_pipe_node_send_event:
+ * @node_name:(transfer none)(nullable): The name of the node to send to
+ * @event:(transfer full)(not nullable): The upstream event to forward
+ *
+ * Forward @event to the node named @node_name, if it exists. The node is
+ * pinned for the duration of the call: gst_inter_pipe_remove_node() waits for
+ * it, so the node cannot be torn down while the event is being delivered.
+ *
+ * Returns: TRUE if the node existed and handled the event, FALSE otherwise.
+ */
+gboolean gst_inter_pipe_node_send_event (const gchar * node_name,
+    GstEvent * event);
+
+/**
+ * gst_inter_pipe_node_send_query:
+ * @node_name:(transfer none)(nullable): The name of the node to query
+ * @query:(transfer none)(not nullable): The query to forward
+ *
+ * Like gst_inter_pipe_node_send_event(), for queries.
+ *
+ * Returns: TRUE if the node existed and answered the query, FALSE otherwise.
+ */
+gboolean gst_inter_pipe_node_send_query (const gchar * node_name,
+    GstQuery * query);
+
+/**
+ * gst_inter_pipe_lock_listeners:
+ *
+ * Take the (recursive) lock that guards listener registration. Listeners
+ * hold it while changing state that node_added / node_removed read.
+ */
+void gst_inter_pipe_lock_listeners (void);
+
+/**
+ * gst_inter_pipe_unlock_listeners:
+ *
+ * Release the lock taken by gst_inter_pipe_lock_listeners().
+ */
+void gst_inter_pipe_unlock_listeners (void);
+
 G_END_DECLS
 #endif // __GST_INTER_PIPE_H__
