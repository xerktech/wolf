+/* Node -> number of event/query forwards currently using it. Guarded by
+ * nodes_mutex. remove_node waits for a node's count to drop to zero, so a
+ * node cannot be torn down under a forward in progress. Forwards do not hold
+ * any lock while they run, since they may block on the producer pipeline. */
+static GHashTable *
+gst_inter_pipe_get_inflight (void)
+{
+  static GHashTable *gst_inter_pipe_inflight = NULL;
+
+  if (!gst_inter_pipe_inflight) {
+    gst_inter_pipe_inflight = g_hash_table_new (g_direct_hash, g_direct_equal);
+  }
+  return gst_inter_pipe_inflight;
+}
+
+static GstInterPipeINode *
+gst_inter_pipe_acquire_node (const gchar * node_name)
+{
+  GHashTable *inflight;
+  GstInterPipeINode *node;
+  guint count;
+
+  g_mutex_lock (&nodes_mutex);
+  node = g_hash_table_lookup (gst_inter_pipe_get_nodes (), node_name);
+  if (node) {
+    inflight = gst_inter_pipe_get_inflight ();
+    count = GPOINTER_TO_UINT (g_hash_table_lookup (inflight, node));
+    g_hash_table_insert (inflight, node, GUINT_TO_POINTER (count + 1));
+  }
+  g_mutex_unlock (&nodes_mutex);
+
+  return node;
+}
+
+static void
+gst_inter_pipe_release_node (GstInterPipeINode * node)
+{
+  GHashTable *inflight;
+  guint count;
+
+  g_mutex_lock (&nodes_mutex);
+  inflight = gst_inter_pipe_get_inflight ();
+  count = GPOINTER_TO_UINT (g_hash_table_lookup (inflight, node));
+  if (count <= 1) {
+    g_hash_table_remove (inflight, node);
+    g_cond_broadcast (&nodes_cond);
+  } else {
+    g_hash_table_insert (inflight, node, GUINT_TO_POINTER (count - 1));
+  }
+  g_mutex_unlock (&nodes_mutex);
+}
