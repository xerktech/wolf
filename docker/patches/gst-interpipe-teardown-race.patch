+
+gboolean
+gst_inter_pipe_node_send_event (const gchar * node_name, GstEvent * event)
+{
+  GstInterPipeINode *node;
+  gboolean ret;
+
+  g_return_val_if_fail (event != NULL, FALSE);
+
+  node = node_name ? gst_inter_pipe_acquire_node (node_name) : NULL;
+  if (!node) {
+    gst_event_unref (event);
+    return FALSE;
+  }
+
+  ret = gst_inter_pipe_inode_receive_event (node, event);
+  gst_inter_pipe_release_node (node);
+
+  return ret;
+}
+
+gboolean
+gst_inter_pipe_node_send_query (const gchar * node_name, GstQuery * query)
+{
+  GstInterPipeINode *node;
+  gboolean ret;
+
+  g_return_val_if_fail (query != NULL, FALSE);
+
+  node = node_name ? gst_inter_pipe_acquire_node (node_name) : NULL;
+  if (!node)
+    return FALSE;
+
+  ret = gst_inter_pipe_inode_receive_query (node, query);
+  gst_inter_pipe_release_node (node);
+
+  return ret;
+}
+
+void
+gst_inter_pipe_lock_listeners (void)
+{
+  g_rec_mutex_lock (&listeners_mutex);
+}
+
+void
+gst_inter_pipe_unlock_listeners (void)
+{
+  g_rec_mutex_unlock (&listeners_mutex);
+}
